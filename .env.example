# PaperLens release configuration. Copy to .env for local development only.
# REQUIRED in production: APP_ENV/DB URL/storage/origins and explicit migrations.
# OPTIONAL in production: AI/embedding credentials, provider budgets, build metadata.
# DEVELOPMENT ONLY defaults: SQLite, localhost origins, auto-created schema.
PAPERLENS_ENVIRONMENT=development
PAPERLENS_DATABASE_URL=sqlite:///./paperlens.db
APP_ENV=development
DATABASE_URL=sqlite:///./paperlens.db
# Comma-separated explicit browser origins; wildcard is rejected.
PAPERLENS_FRONTEND_ORIGIN=http://localhost:3000
PAPERLENS_FRONTEND_ORIGINS=
FRONTEND_ORIGIN=http://localhost:3000
PAPERLENS_BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_PUBLIC_URL=http://localhost:8000
PAPERLENS_ARXIV_REQUEST_TIMEOUT=30
PAPERLENS_STORAGE_PATH=data/papers
PAPER_STORAGE_PATH=data/papers
PAPERLENS_STORAGE_PROVIDER=local
PAPERLENS_MAX_PDF_SIZE=52428800
PAPERLENS_MAX_REQUEST_BODY_SIZE=1048576
PAPERLENS_MAX_PAPER_TEXT_CHARS=5000000
PAPERLENS_MAX_PAGE_COUNT=500
# Phase 14 bounded, isolated PDF parsing. The explicit names override the
# legacy PAPERLENS_MAX_* aliases above when provided.
PDF_MAX_BYTES=52428800
PDF_MAX_PAGES=500
PDF_MAX_TEXT_CHARS=5000000
PDF_MAX_TEXT_CHARS_PER_PAGE=
PDF_MAX_IMAGES_PER_PAGE=100
PDF_MAX_TOTAL_IMAGES=1000
PDF_PARSE_TIMEOUT_SECONDS=120
PDF_PARSE_CONCURRENCY=2
PDF_PARSER_MEMORY_LIMIT_BYTES=
PDF_PARSER_CPU_LIMIT_SECONDS=
PAPERLENS_REQUEST_TIMEOUT=120
PAPERLENS_METRICS_ENABLED=true
PAPERLENS_AUTO_CREATE_SCHEMA=true
# Shared/staging/production deployments require session authentication. Keep
# false only for explicitly local development/desktop mode.
PAPERLENS_AUTH_REQUIRED=false
PAPERLENS_AUTH_COOKIE_NAME=paperlens_session
PAPERLENS_AUTH_SESSION_TTL_SECONDS=604800
PAPERLENS_TRUSTED_PROXY_IPS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
PAPERLENS_RATE_LIMITS_ENABLED=false
PAPERLENS_RATE_LIMIT_INGESTION_PER_MINUTE=4
PAPERLENS_RATE_LIMIT_AI_PER_MINUTE=6
PAPERLENS_RATE_LIMIT_CHAT_PER_MINUTE=20
PAPERLENS_RATE_LIMIT_RESEARCH_PER_MINUTE=2
PAPERLENS_AI_ANALYSIS_ENABLED=
PAPERLENS_SEMANTIC_RETRIEVAL_ENABLED=
PAPERLENS_RESEARCH_AGENT_ENABLED=
PAPERLENS_RELEASE_VERSION=0.1.0-beta
PAPERLENS_BUILD_SHA=local
PAPERLENS_BUILD_TIMESTAMP=unknown
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2
CHAT_RETRIEVAL_TOP_K=8
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_MIN_RELEVANCE=0.1
CHAT_MAX_QUESTION_CHARS=4000
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=hash-v1
EMBEDDING_DIMENSION=64
EMBEDDING_VERSION=v1
SEMANTIC_RETRIEVAL_TOP_K=8
HYBRID_RETRIEVAL_ENABLED=false
RETRIEVAL_MODE=LEXICAL
RESEARCH_MAX_SEARCH_QUERIES=6
RESEARCH_MAX_CANDIDATES=30
RESEARCH_MAX_INGESTED_PAPERS=8
RESEARCH_MAX_ITERATIONS=3
RESEARCH_INGESTION_CONCURRENCY=2
RESEARCH_MAX_CONTEXT_CHARS=12000
RESEARCH_MAX_PROVIDER_CALLS=32
RESEARCH_STEP_TIMEOUT=180
PAPERLENS_RESEARCH_WORKER_ENABLED=false
RESEARCH_WORKER_CONCURRENCY=1
RESEARCH_WORKER_POLL_SECONDS=2
RESEARCH_CLAIM_LEASE_SECONDS=60
RESEARCH_MAX_ATTEMPTS=3
MAX_CONCURRENT_INGESTIONS=2
